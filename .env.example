# ---- پایگاه‌داده ----
# لوکال: PostgreSQL روی پورت ۵۴۳۳ (هماهنگ با schema.prisma)
#   postgresql://postgres:PASSWORD@localhost:5433/hassani?schema=public
# نمونهٔ ابری (Neon/Supabase):
#   postgresql://user:pass@host/db?sslmode=require
# تولید (Docker compose سرور): سرویس db در شبکهٔ داخلی
#   postgresql://<app>:<pass>@db:5432/<app>?schema=public
DATABASE_URL=

# ---- آدرس عمومی سایت (سئو/canonical/sitemap) ----
# حتماً ست شود؛ وگرنه همهٔ لینک‌ها روی localhost می‌مانند.
NEXT_PUBLIC_SITE_URL=https://hassani-yadak.ir

# ---- احراز هویت مشتری ----
CUSTOMER_SECRET=change-me-to-a-long-random-string

# ---- پنل ادمین ----
# ⚠️ این متغیرها در production الزامی‌اند؛ اگر ست نشوند اپ عمداً fail می‌کند.
# ADMIN_USERNAME/ADMIN_PASSWORD → حساب مالک (owner) در اولین اجرا ساخته می‌شود.
# ADMIN_SECRET → کلید امضای کوکی نشست (openssl rand -hex 32)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
ADMIN_SECRET=

# ---- تنظیمات هوش مصنوعی ----
# ارائه‌دهنده و کلیدها از پنل ادمین هم قابل‌تنظیماند؛ این‌ها فقط پیش‌فرض‌اند.
# provider: anthropic | openai | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# روی سرور ایران، APIهای AI IP ایرانی را مسدود می‌کنند؛
# یک پروکسی/روتر خارجی (مثلاً https://gorouter.app/v1) اینجا ست شود.
AI_BASE_URL=
AI_MODEL=

# SEO Agent receiver (optional) - get the value from the SEO panel owner
SEO_AGENT_SECRET=
